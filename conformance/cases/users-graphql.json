{
  "name": "users-graphql",
  "schema": {
    "name": "User",
    "fields": {
      "_id": { "type": "string" },
      "name": { "type": "string" },
      "age": { "type": "int" }
    }
  },
  "steps": [
    {
      "op": "mutation",
      "query": "mutation($input: JSON!) { create_User(input: $input) { _id name age } }",
      "variables": { "input": { "name": "a", "age": 1 } },
      "expect": { "dataKeys": ["create_User"] }
    },
    {
      "op": "query",
      "query": "query($c: JSON, $l: Int) { list_User(condition: $c, limit: $l) { name } }",
      "variables": { "c": { "name": "a" }, "l": 10 },
      "expect": {
        "dataKeys": ["list_User"],
        "gql": "User($condition:@c0,$limit:@l) { name }"
      }
    },
    {
      "op": "query",
      "query": "{ list_User { _id } }",
      "variables": {},
      "expect": {
        "gql": "User($limit:@l) { _id }",
        "paramsLimit": 50,
        "_comment": "spec/02 limit 守卫:缺省补 50"
      }
    },
    {
      "op": "query",
      "query": "query($l: Int) { list_User(limit: $l) { _id } }",
      "variables": { "l": 1001 },
      "expect": {
        "errorCodePrefix": "ERR_LIMIT:",
        "_comment": "spec/02 limit 守卫:超上限抛错,不静默截断"
      }
    },
    {
      "op": "query",
      "query": "query($c: JSON) { list_User(condition: $c) { _id _score } }",
      "variables": { "c": { "name": { "$near": { "$vector": [0.1, 0.2], "$limit": 2 } } } },
      "expect": {
        "gql": "User($condition:@c0) { _id, _score }",
        "_comment": "04:含 $near 时不拼根 $limit;向量查询条数唯一来源是 $near.$limit"
      }
    },
    {
      "op": "query",
      "query": "query($c: JSON, $l: Int) { list_User(condition: $c, limit: $l) { _id } }",
      "variables": {
        "c": { "name": { "$near": { "$vector": [0.1, 0.2], "$limit": 2 } } },
        "l": 10
      },
      "expect": {
        "errorCodePrefix": "ERR_LIMIT:",
        "_comment": "04:显式 limit 与 $near 互斥"
      }
    },
    {
      "op": "query",
      "query": "query($c: JSON) { list_User(condition: $c) { _id } }",
      "variables": { "c": { "name": { "$near": { "$vector": [0.1, 0.2], "$limit": 5000 } } } },
      "expect": {
        "errorCodePrefix": "ERR_LIMIT:",
        "_comment": "04:$near.$limit 上界由皮守卫"
      }
    },
    {
      "op": "query",
      "query": "{ get_User(id: \"u1\") { name } }",
      "variables": {},
      "expect": { "dataKeys": ["get_User"] }
    },
    {
      "op": "mutation",
      "query": "mutation($id: ID!, $set: JSON!) { update_User(id: $id, set: $set) { name age } }",
      "variables": { "id": "u1", "set": { "age": 2 } },
      "expect": { "dataKeys": ["update_User"] }
    },
    {
      "op": "mutation",
      "query": "mutation { delete_User(id: \"u1\") }",
      "variables": {},
      "expect": { "dataKeys": ["delete_User"] }
    }
  ]
}
